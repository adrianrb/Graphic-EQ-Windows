// Ícone e metadados do executável.
#include "resource.h"

IDI_APP ICON "app.ico"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004L
FILETYPE 0x1L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "adrian.barbosa@gmail.com"
            VALUE "FileDescription", "Graphic EQ - Visualizador de espectro"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "GraphicEQ"
            VALUE "OriginalFilename", "GraphicEQ.exe"
            VALUE "ProductName", "Graphic EQ"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
